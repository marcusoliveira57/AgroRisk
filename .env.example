# Credenciais do banco de dados
# Esses valores já estão configurados no docker-compose.yml
# Copie este arquivo para .env antes de executar o projeto:
#   cp .env.example .env
# Ou altere manualmente as credenciais para rodar em postgres local

DB_HOST=db # Use 'db' para Docker, ou 'localhost' para execução local
DB_PORT=5432
DB_NAME=agrorisk
DB_USER=agrorisk
DB_PASSWORD=agrorisk
